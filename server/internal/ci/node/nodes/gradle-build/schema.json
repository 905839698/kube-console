{
  "type": "gradle-build",
  "properties": [
    {
      "name": "jdk",
      "type": "select",
      "required": false,
      "default": "17",
      "options": [
        {
          "value": "8",
          "label": "JDK 8"
        },
        {
          "value": "11",
          "label": "JDK 11"
        },
        {
          "value": "17",
          "label": "JDK 17"
        },
        {
          "value": "21",
          "label": "JDK 21"
        }
      ]
    },
    {
      "name": "command",
      "type": "text",
      "required": false,
      "default": "build -x test",
      "description": "Gradle 任务（如 build -x test / assemble）"
    },
    {
      "name": "outputDir",
      "type": "string",
      "required": false,
      "default": "build/libs/*.jar",
      "description": "输出目录 / 通配"
    },
    {
      "name": "useWrapper",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "优先使用 gradlew"
    },
    {
      "name": "preShell",
      "type": "text",
      "required": false,
      "description": "前置 shell（可选）：本节点主步骤前在同一容器/工作区执行"
    },
    {
      "name": "cache",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "启用项目级依赖缓存（挂载缓存 PVC，依赖包不再每次重新下载；同项目并发运行时可能因 RWO 卷排队，建议错峰或使用 RWX 存储）"
    }
  ]
}
