{
  "type": "go-build",
  "properties": [
    {
      "name": "goVersion",
      "type": "select",
      "required": false,
      "default": "1.22",
      "options": [
        {
          "value": "1.20",
          "label": "Go 1.20"
        },
        {
          "value": "1.21",
          "label": "Go 1.21"
        },
        {
          "value": "1.22",
          "label": "Go 1.22"
        },
        {
          "value": "1.23",
          "label": "Go 1.23"
        },
        {
          "value": "1.24",
          "label": "Go 1.24"
        },
        {
          "value": "1.25",
          "label": "Go 1.25"
        }
      ]
    },
    {
      "name": "goproxy",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Go 模块代理（留空沿用镜像内置 GOPROXY）：内网/受限环境填 Nexus goproxy 等内网代理地址，运行时以环境变量覆盖"
    },
    {
      "name": "command",
      "type": "text",
      "required": false,
      "default": "build ./...",
      "description": "Go 命令（build/test/vet ./...）"
    },
    {
      "name": "binaryName",
      "type": "string",
      "required": false,
      "default": "app",
      "description": "产物二进制名"
    },
    {
      "name": "runTest",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "先执行 go test"
    },
    {
      "name": "preShell",
      "type": "text",
      "required": false,
      "description": "前置 shell（可选）：本节点主步骤前在同一容器/工作区执行"
    },
    {
      "name": "cache",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "启用项目级依赖缓存（挂载缓存 PVC，依赖包不再每次重新下载；不同流水线同项目可并行（工作区按流水线分目录）；缓存为项目级共享，npm/go 等依赖缓存自身并发安全）"
    }
  ]
}
